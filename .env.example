# Terminal 3 API key. Required for the TEE path.
T3N_API_KEY=

# OpenRouter API key. Required for /api/chat.
OPENROUTER_API_KEY=

# Requires x-api-key on check-wallet, check-batch, and chat. Leave blank to keep the demo open.
API_KEY=

# Requests per client per window, and the window in milliseconds.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# API and dashboard port.
PORT=3001
