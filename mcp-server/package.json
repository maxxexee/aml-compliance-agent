{
  "name": "r3nzo-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for R3nzo AML Compliance Agent: privacy-preserving wallet checks via Terminal 3 TEE",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "r3nzo-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@terminal3/t3n-sdk": "^5.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.23.15"
  },
  "keywords": ["mcp", "aml", "compliance", "terminal3", "tee", "wallet-check"],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  }
}
